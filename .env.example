# Copy to `.dev.vars` for local development (never commit it).
# In production set each secret with: pnpm wrangler secret put <NAME>

# 32+ random bytes: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Cloudflare Turnstile. The values below are Cloudflare's always-pass TEST keys.
# TURNSTILE_SITE_KEY is public and lives in wrangler.jsonc "vars".
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Resend. Leave empty locally: emails are printed to the dev console instead.
RESEND_API_KEY=

# PayMongo. Use TEST keys (sk_test_...) until live payments are approved.
PAYMONGO_SECRET_KEY=
# whsk_... returned when the webhook is registered (see DEPLOYMENT.md)
PAYMONGO_WEBHOOK_SECRET=

# Shared secret for the internal daily cron endpoint: openssl rand -hex 32
CRON_SECRET=

# Tells OpenNext which Next.js .env files to load locally
NEXTJS_ENV=development

# Non-secret vars (set in wrangler.jsonc "vars", listed here for reference):
# APP_ENV=development|production
# PUBLIC_SITE_URL=https://your-domain.ph
# EMAIL_FROM="Tibay <no-reply@your-domain.ph>"
# SUPPORT_EMAIL=support@your-domain.ph
# TURNSTILE_SITE_KEY=...
